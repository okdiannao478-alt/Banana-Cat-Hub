{
  "name": "raccoon-discord-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Raccoon Discord purchase-code redemption and device licensing bot",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "check": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
